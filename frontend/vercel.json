{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "vitaglossrd.com" }],
      "destination": "https://www.vitaglossrd.com/$1",
      "permanent": true
    },
    { "source": "/empieza", "destination": "/equipo", "permanent": true },
    { "source": "/unete", "destination": "/equipo", "permanent": true },
    { "source": "/checkout", "destination": "/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/producto/:slug", "destination": "/producto/:slug.html" },
    { "source": "/blog/:slug", "destination": "/blog/:slug.html" },
    { "source": "/combos/:id", "destination": "/combos/:id.html" },
    { "source": "/catalogo", "destination": "/catalogo.html" },
    { "source": "/combos", "destination": "/combos.html" },
    { "source": "/blog", "destination": "/blog.html" },
    { "source": "/sobre-nosotros", "destination": "/sobre-nosotros.html" },
    { "source": "/equipo", "destination": "/equipo.html" },
    { "source": "/contacto", "destination": "/contacto.html" },
    { "source": "/faq", "destination": "/faq.html" },
    { "source": "/privacidad", "destination": "/privacidad.html" },
    { "source": "/devoluciones", "destination": "/devoluciones.html" },
    { "source": "/terminos", "destination": "/terminos.html" },
    { "source": "/politica-editorial", "destination": "/politica-editorial.html" },
    { "source": "/pelo-piel-unas", "destination": "/pelo-piel-unas.html" },
    { "source": "/dashboard", "destination": "/_app.html" },
    { "source": "/academia", "destination": "/_app.html" },
    { "source": "/mi-equipo-ventas", "destination": "/_app.html" },
    { "source": "/orden-confirmada", "destination": "/_app.html" },
    { "source": "/cert-pagadito", "destination": "/_app.html" },
    { "source": "/restablecer-contrasena", "destination": "/_app.html" }
  ],
  "headers": [
    {      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*\\.(?:webp|png|jpg|jpeg|gif|svg|ico|woff2|woff))",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000" }
      ]
    },
    {      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://pagead2.googlesyndication.com https://googleads.g.doubleclick.net https://tpc.googlesyndication.com https://www.googletagmanager.com https://connect.facebook.net https://www.gstatic.com https://*.adtrafficquality.google; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://randomuser.me https://*.googlesyndication.com https://*.doubleclick.net https://www.facebook.com https://www.google.com https://i.ytimg.com; connect-src 'self' https://vitaglossrd-production.up.railway.app https://www.google-analytics.com https://region1.google-analytics.com https://stats.g.doubleclick.net https://ep1.adtrafficquality.google https://*.googlesyndication.com https://www.facebook.com; frame-src https://googleads.g.doubleclick.net https://tpc.googlesyndication.com https://www.google.com https://*.adtrafficquality.google https://www.youtube.com https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self';"
        }
      ]
    }
  ]
}
