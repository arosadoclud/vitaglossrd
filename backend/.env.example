# ============================================
# VitaGloss RD API — Variables de Entorno
# ============================================
# Copia este archivo a .env y rellena los valores

PORT=4000

# MongoDB Atlas — Pega aquí tu connection string
# Formato: mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USUARIO:PASSWORD@cluster0.XXXXX.mongodb.net/vitagloss?retryWrites=true&w=majority

# JWT Secret — genera una cadena aleatoria de al menos 64 caracteres
JWT_SECRET=REEMPLAZA_CON_UN_SECRETO_ALEATORIO_DE_64_CARACTERES

# Tiempo de expiración del token (7 días)
JWT_EXPIRES_IN=7d

# Frontend URL (para CORS)
FRONTEND_URL=http://localhost:5173

# Administrador inicial — úsalo solo para ejecutar `npm run seed:admin`.
# Después de crear o actualizar el administrador, elimina ADMIN_PASSWORD.
ADMIN_NAME=Administrador VitaGloss RD
ADMIN_EMAIL=admin@tudominio.com
ADMIN_PASSWORD=REEMPLAZA_CON_UNA_CLAVE_UNICA_Y_SEGURA
ADMIN_WHATSAPP=18492763532

# WhatsApp Service (whatsapp-service local o en servidor)
WA_SERVICE_URL=http://localhost:3002
WA_SECRET=REEMPLAZA_CON_UN_SECRETO_ALEATORIO

# Link del webinar (Google Meet, Zoom, YouTube Live, etc.)
WEBINAR_LINK=https://meet.google.com/vitaglossrd

# ── WhatsApp Business API (Meta) ─────────────────────────────────────────────
# Obtén estos valores en: https://developers.facebook.com → Tu App → WhatsApp → Configuración
#
# 1. WA_TOKEN       = Token de acceso de usuario del sistema (System User Access Token)
#                     o token temporal de la consola de Meta
# 2. WA_PHONE_ID    = Phone Number ID (no es el número de teléfono, es el ID interno de Meta)
# 3. WA_VERIFY_TOKEN = Cualquier string que tú elijas. Debes escribir el mismo en el panel de Meta
#                      al registrar la URL del webhook.
# 4. WA_ADMIN_NUMBER = Tu número de WhatsApp (solo dígitos, sin +) para recibir notificaciones
#                      Ejemplo para RD: 18492763532

WA_TOKEN=PEGA_AQUI_TU_ACCESS_TOKEN
WA_PHONE_ID=PEGA_AQUI_EL_PHONE_NUMBER_ID
WA_VERIFY_TOKEN=REEMPLAZA_CON_UN_TOKEN_DE_VERIFICACION_ALEATORIO
WA_ADMIN_NUMBER=18492763532

# ── n8n ──────────────────────────────────────────────────────────────────────
# URL del webhook de n8n que recibe los pedidos del bot.
# En n8n local: http://localhost:5678/webhook/nuevo-pedido-wa
# En n8n cloud: https://TU_CUENTA.app.n8n.cloud/webhook/nuevo-pedido-wa

N8N_ORDER_WEBHOOK=http://localhost:5678/webhook/nuevo-pedido-wa
